+router.post("/reports/archive", async (req, res, next) => {
+  const dir = String(req.body.dir ?? "daily");
+  const archiveName = path.basename(String(req.body.archiveName ?? "report.tgz"));
+  const archivePath = path.join("/tmp", archiveName);
+  exec(`tar -czf ${archivePath} ${REPORT_ROOT}/${dir}`, (err) => {
+    if (err) return next(err);
+    res.json({ archivePath });
+  });
+});
+
+router.get("/session", (req, res) => {
+  const token = String(req.headers.authorization ?? "").replace(/^Bearer\s+/i, "");
+  const claims = jwt.decode(token) as { sub?: string; admin?: boolean } | null;
+  if (!claims?.admin) {
+    res.status(403).json({ error: "admin token required" });
+    return;
+  }
+  res.json({ userId: claims.sub });
+});
