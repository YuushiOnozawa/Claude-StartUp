-  return lines.reduce((sum, line) => {
+export interface Invoice {
+  id: string;
+  customerId: string;
+  currency: string;
+  lines: InvoiceLine[];
+}
+
+export interface CalculateInvoiceOptions {
+  taxRate: number;
+  includeDiscounts: boolean;
+}
+
+export interface InvoiceTotal {
+  subtotalCents: number;
+  taxCents: number;
+  totalCents: number;
+  currency: string;
+}
+
+export function calculateInvoiceTotal(invoice: Invoice, options: CalculateInvoiceOptions): InvoiceTotal {
+  const subtotalCents = invoice.lines.reduce((sum, line) => {
     const lineTotal = line.quantity * line.unitPrice;
-    return sum + lineTotal - (line.discountCents ?? 0);
+    const discount = options.includeDiscounts ? line.discountCents ?? 0 : 0;
+    return sum + lineTotal - discount;
   }, 0);
+  const taxCents = Math.round(subtotalCents * options.taxRate);
+  return { subtotalCents, taxCents, totalCents: subtotalCents + taxCents, currency: invoice.currency };
 }
 
 export function calculateInvoiceTotalPreview(lines: InvoiceLine[]): string {
   return `${lines.length} lines`;
 }
