diff --git a/scripts/lib/review-digest.sh b/scripts/lib/review-digest.sh
index 2d1e9b0..7a8c9f1 100644
--- a/scripts/lib/review-digest.sh
+++ b/scripts/lib/review-digest.sh
@@ -1,49 +1,110 @@
 #!/usr/bin/env bash
 set -euo pipefail
 
 DIGEST_STATE_DIR="${DIGEST_STATE_DIR:-${HOME}/.claude/review-digest}"
 DIGEST_CONFIG="${DIGEST_CONFIG:-${DIGEST_STATE_DIR}/config.env}"
 
+_review_digest_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+source "${_review_digest_script_dir}/../review-digest-publish.sh"
+
 review_comment_payload() {
   local session_id="$1"
   local body_file="$2"
   printf '{"session":"%s","body":%s}\n' "$session_id" "$(jq -Rs . < "$body_file")"
 }
 
 dispatch_review_comment() {
   local queue_file="$1"
   local session_id="$2"
   local body_file="$3"
   local dry_run="${4:-0}"
   post_review_comment "$queue_file" "$session_id" "$body_file" "$dry_run"
 }
 
 post_review_comment() {
-  local queue_file="$1"
-  local session_id="$2"
-  local body_file="$3"
-  local dry_run="${4:-0}"
+  local body_file="$1"
+  local queue_file="$2"
+  local dry_run="${3:-0}"
   local endpoint
   endpoint="$(queue_endpoint_for "$queue_file")"
 
   if [[ "$dry_run" == "1" ]]; then
-    review_comment_payload "$session_id" "$body_file"
+    review_comment_payload "review-session" "$body_file"
     return 0
   fi
 
-  review_comment_payload "$session_id" "$body_file" | curl -fsS -X POST --data-binary @- "$endpoint"
+  review_comment_payload "review-session" "$body_file" | curl -fsS -X POST --data-binary @- "$endpoint"
 }
 
 publish_review_digest() {
   local config_file="${1:-$DIGEST_CONFIG}"
-  load_digest_config "$config_file"
-  fetch_review_events "$REVIEW_EVENTS_URL" | render_digest_markdown | post_review_digest "$REVIEW_DIGEST_POST_URL"
+  local work_dir
+  work_dir="$(mktemp -d)"
+  local events_json="${work_dir}/events.json"
+  local digest_md="${work_dir}/digest.md"
+
+  if [[ -f "$config_file" ]]; then
+    while IFS='=' read -r key value; do
+      case "$key" in
+        REVIEW_EVENTS_URL) REVIEW_EVENTS_URL="$value" ;;
+        REVIEW_DIGEST_POST_URL) REVIEW_DIGEST_POST_URL="$value" ;;
+      esac
+    done < "$config_file"
+  fi
+
+  : "${REVIEW_EVENTS_URL:=http://localhost:8765/events}"
+  : "${REVIEW_DIGEST_POST_URL:=http://localhost:8765/digest}"
+
+  curl -fsS "$REVIEW_EVENTS_URL" > "$events_json"
+  {
+    printf '# Review digest\n\n'
+    jq -r '.events[] | "- " + .title + " (" + .owner + ")"' "$events_json"
+    printf '\nGenerated from %s\n' "$REVIEW_EVENTS_URL"
+  } > "$digest_md"
+  wrap_digest_for_publish "$(cat "$digest_md")" > "${digest_md}.ready"
+  mv "${digest_md}.ready" "$digest_md"
+  curl -fsS -X POST -H 'Content-Type: text/markdown' --data-binary "@${digest_md}" "$REVIEW_DIGEST_POST_URL" >/dev/null
+  rm -rf "$work_dir"
 }
 
 run_review_digest_publish() {
-  publish_review_digest "$DIGEST_CONFIG"
+  local queue_file="${1:-${DIGEST_STATE_DIR}/queue.tsv}"
+  local target_stream="${2:-daily}"
+  local selected_ids
+
+  selected_ids="$(
+    sed -E '/^[[:space:]]*(#|$)/d; s/[[:space:]]+$//' "$queue_file" \
+      | awk -F '\t' -v stream="$target_stream" '$3 == stream { print $1 }' \
+      | sort -u
+  )"
+
+  if [[ -z "$selected_ids" ]]; then
+    return 0
+  fi
+
+  publish_review_digest "$DIGEST_CONFIG"
+}
+
+emit_digest() {
+  printf '%s\n' "$1"
+}
+
+wrap_digest_once() {
+  emit_digest "$1"
+}
+
+wrap_digest_twice() {
+  wrap_digest_once "$1"
+}
+
+wrap_digest_for_publish() {
+  wrap_digest_twice "$1"
+}
+
+main() {
+  run_review_digest_publish "$@"
 }
 
 if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
-  run_review_digest_publish "$@"
+  main "$@"
 fi
